@using OCWebOverview.Services
@using Microsoft.Extensions.Options
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<AuthOptions> ApplicationSettings


<NavLink class="nav-link" href="/" style="color: white">
    <span style="margin-left: 20px; font-size: medium">Home</span>
</NavLink>
@if (AuthenticationStateProvider.GetAuthenticationStateAsync().Result is { User.Identity.IsAuthenticated: true })
{
    <NavLink class="nav-link" href="clienten" style="color: white">
        <span style="margin-left: 20px; font-size: medium">Cliënten</span>
    </NavLink>
    <NavLink class="nav-link" href="gemeentes" style="color: white">
        <span style="margin-left: 20px; font-size: medium">Gemeentes</span>
    </NavLink>
    <NavLink class="nav-link" href="werknemers" style="color: white">
        <span style="margin-left: 20px; font-size: medium">Werknemers</span>
    </NavLink>
    <NavLink class="nav-link" href="@($"/panel?id={ApplicationSettings.Value.PanelId}")" style="color: white">
        <span style="margin-left: 20px; font-size: medium">Scherm Overview</span>
    </NavLink>
}


