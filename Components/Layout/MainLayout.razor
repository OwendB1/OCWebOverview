@inherits LayoutComponentBase
@inject NavigationManager NavManager

<MudThemeProvider Theme="_omnisCuraTheme" />
<MudDialogProvider MaxWidth="MaxWidth.ExtraExtraLarge" DisableBackdropClick="true"/>
<MudSnackbarProvider />

@if (NavManager.Uri.Contains("panel") == false && NavManager.Uri.Contains("Account") == false)
{
    <MudLayout>
        <MudAppBar Elevation="0">
            <img src="oclogo.png" height="50" />
            <NavMenu />
            <MudSpacer/>
            <LoginDisplay/>
        </MudAppBar>
        
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-2; overflow-x-scroll;">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    @Body
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    MudTheme _omnisCuraTheme = new ()
    {
        Palette = new PaletteLight()
        {
            Primary = Colors.Orange.Default,
            Secondary = Colors.Green.Accent4,
            Info = Colors.Shades.White,
            AppbarBackground = Colors.Grey.Darken3,
            TableHover = Colors.Orange.Accent2,
            ChipDefaultHover = Colors.Orange.Default
        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };
}
