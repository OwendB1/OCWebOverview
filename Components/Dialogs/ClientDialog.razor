@using OCWebOverview.Data.Entities
@using OCWebOverview.Data.Collections
@inject WerknemerCollection WerknemerCollection
@inject GemeenteCollection GemeenteCollection
@inject ClientCollection ClientCollection
@inject ISnackbar Snackbar

<EditForm Model="@Client" OnValidSubmit="Submit">
    <DataAnnotationsValidator/>
    <MudDialog>
        <DialogContent>
            <MudGrid>
                <MudItem xs="5">
                    <MudTextField @bind-Value="Client.Voornaam" Label="Voornaam" For="() => Client.Voornaam" ReadOnly="ReadOnly" />
                </MudItem>
                <MudItem xs="7">
                    <MudTextField @bind-Value="Client.Achternaam" Label="Achternaam" For="() => Client.Achternaam" ReadOnly="ReadOnly" />
                </MudItem>
            </MudGrid>
            <MudDatePicker @bind-Date="StartDatum" Label="Start Datum" Required="true" ReadOnly="ReadOnly" />
            <MudDatePicker @bind-Date="EindDatum" Label="Eind Datum" Required="true" ReadOnly="ReadOnly" />
            <MudGrid>
                <MudItem xs="9">
                    <MudSelect @bind-Value="Client.HoofdWerknemerId" Label="Hoofd Werknemer" For="() => Client.HoofdWerknemerId" ReadOnly="ReadOnly">
                        @foreach (var werknemer in _werknemers)
                        {
                            <MudSelectItem Value="werknemer.Id">@werknemer.Naam</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="Client.ZorgUrenHoofd" Label="Zorg Uren" For="() => Client.ZorgUrenHoofd" ReadOnly="ReadOnly" />
                </MudItem>
            </MudGrid>
           <MudGrid>
                <MudItem xs="9">
                    <MudSelect @bind-Value="Client.ExtraWerknemerId" Label="Ondersteunende Werknemer" Clearable="true" ReadOnly="ReadOnly">
                        @foreach (var werknemer in _werknemers)
                        {
                            <MudSelectItem Value="(Guid?)werknemer.Id">@werknemer.Naam</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="3">
                    <MudNumericField @bind-Value="Client.ZorgUrenExtra" Label="Zorg Uren" ReadOnly="ReadOnly" />
                </MudItem>
            </MudGrid>
            <MudSelect @bind-Value="Client.ZorgType" Label="Zorg Type" For="() => Client.ZorgType" ReadOnly="ReadOnly">
                <MudSelectItem Value="ZorgType.Jeugd"/>
                <MudSelectItem Value="ZorgType.WMO"/>
            </MudSelect>
            <MudSelect @bind-Value="Client.GemeenteId" Label="Gemeente" For="() => Client.GemeenteId" ReadOnly="ReadOnly">
                @foreach (var gemeente in GemeenteCollection.GetAllGemeentes())
                {
                    <MudSelectItem Value="gemeente.Id">@gemeente.Naam</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.h6">Adres</MudText>
            <MudGrid>
                <MudItem xs="9">
                    <MudTextField @bind-Value="Client.Adres.Straat" Label="Straat" For="() => Client.Adres.Straat" ReadOnly="ReadOnly" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="Client.Adres.HuisNummer" Label="Huisnummer" For="() => Client.Adres.HuisNummer" ReadOnly="ReadOnly" />
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="Client.Adres.Postcode" Label="Postcode" For="() => Client.Adres.Postcode" ReadOnly="ReadOnly" />
            <MudTextField @bind-Value="Client.Adres.Plaats" Label="Plaats" For="() => Client.Adres.Plaats" ReadOnly="ReadOnly" />
        </DialogContent>
        <DialogActions>
            @if (ReadOnly)
            {
                <MudButton OnClick="Cancel">Close</MudButton>
            }
            else
            {
                <MudButton OnClick="Cancel">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit">@ButtonText</MudButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public Client Client { get; set; }
    [Parameter] public string ButtonText { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    private IEnumerable<Guid> Extras { get; set; } = new HashSet<Guid>();
    private List<Werknemer> _werknemers;
    private DateTime? StartDatum;
    private DateTime? EindDatum;

    protected override void OnInitialized()
    {
        _werknemers = WerknemerCollection.GetAllWerknemers().Where(w => w.IsActiveInOverview).ToList();
        StartDatum = Client.StartDatum;
        EindDatum = Client.EindDatum;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        if (ClientCollection.GetAllClients().Count(c => c.Voornaam == Client.Voornaam && c.Achternaam == Client.Achternaam) > 1)
        {
            Snackbar.Add("Er bestaat al een clïent met deze combinatie van voornaam en achternaam. U kunt niet nog een toevoegen.", Severity.Error);
            return;
        }
        if (Client.HoofdWerknemerId == Client.ExtraWerknemerId)
        {
            Snackbar.Add("Hoofd werknemer en ondersteunende werknemer kunnen niet hetzelfde zijn.", Severity.Error);
            return;
        }
        Client.StartDatum = (DateTime)StartDatum!;
        Client.EindDatum = (DateTime)EindDatum!;
        MudDialog.Close(DialogResult.Ok(Client));
    }
}
