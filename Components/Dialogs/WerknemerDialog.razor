@using OCWebOverview.Data.Entities

<MudDialog>
    <DialogContent>
        <EditForm Model="@Werknemer">
            <DataAnnotationsValidator/>
            <MudGrid>
                <MudItem xs="3">
                    <MudTextField @bind-Value="Werknemer.Naam" Label="Naam"/>
                </MudItem>
                <MudItem xs="9">
                    <MudNumericField @bind-Value="Werknemer.UrenPerWeek" Label="Uren Per Week"/>
                </MudItem>
            </MudGrid>
            <MudDatePicker @bind-Value="Werknemer.StartDatum" Date="Werknemer.StartDatum" Label="Start Datum" />
            <MudColorPicker @bind-Text="Werknemer.ColorHexCode" Label="Kleur" ColorPickerMode="ColorPickerMode.HEX"/>
            <MudSwitch @bind-Value="Werknemer.IsActiveInOverview" Label="Zichtbaar in overview?" Color="Color.Success"/>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public Werknemer Werknemer { get; set; }
    [Parameter] public string ButtonText { get; set; }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Werknemer));
    }
}
