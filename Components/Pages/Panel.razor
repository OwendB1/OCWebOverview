@page "/panel"
@using OCWebOverview.Data.Collections
@using OCWebOverview.Data.Entities
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using OCWebOverview.Components.Dialogs
@using OCWebOverview.Services
@inject NavigationManager NavigationManager
@inject ClientCollection ClientCollection
@inject GemeenteCollection GemeenteCollection
@inject WerknemerCollection WerknemerCollection
@inject IOptions<AuthOptions> ApplicationSettings
@inject IDialogService DialogService

<img src="oclogo.png" height="50" />
@if (_id != ApplicationSettings.Value.PanelId)
{
    <MudText Typo="Typo.body1">Geen toegang tot deze content!</MudText>
}
else
{
    <div class="d-inline-flex pa-2" style="height: 98.8vh">
        @foreach (var werknemer in Werknemers)
        {
            var clientsPerWerknemer = Clients.Where(c => c.HoofdWerknemerId == werknemer.Id);
            <MudPaper Class="ma-1" MinWidth="350px" Style="display: flex; flex-direction: column">
                <div class="pa-3 d-inline-flex align-items-center">
                    <MudText Typo="Typo.h6">@werknemer.Initialen @werknemer.Achternaam</MudText>
                    <MudIcon Size="Size.Medium" Icon="@Icons.Material.Rounded.Square" Style="@($"color:{werknemer.ColorHexCode};")"/>
                </div>
                <div Class="mud-grid d-inline-flex x-overflow-auto">
                    @foreach (var client in clientsPerWerknemer)
                    {
                        <MudItem Class="pa-1" xs="6">
                            <MudPaper Class="pa-1" Elevation="4" Outlined="true">
                                <MudLink OnClick="() => Show(client)" Underline="Underline.None">
                                    <MudText Typo="Typo.body1">@client.Initialen @client.Achternaam</MudText>
                                    <MudText Typo="Typo.body1">Type: @client.ZorgType</MudText>
                                    <MudText Typo="Typo.body1">Uren: @client.ZorgUren</MudText>
                                    <div class="d-inline-flex align-items-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Dark"/>
                                        <MudText Typo="Typo.body1">@client.ExtraWerknemerIds.Count</MudText>
                                    </div>
                                </MudLink>
                            </MudPaper>
                        </MudItem>
                    }
                </div>
            </MudPaper>
        }
    </div>
}

@code {
    private IEnumerable<Client> Clients;
    private IEnumerable<Gemeente> Gemeentes;
    private IEnumerable<Werknemer> Werknemers;
    private string? _id;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("id", out var idValue))
        {
            _id = idValue;
        }

        ClientCollection.DataChanged += StateChange;
        GemeenteCollection.DataChanged += StateChange;
        WerknemerCollection.DataChanged += StateChange;

        Clients = ClientCollection.GetAllClients();
        Gemeentes = GemeenteCollection.GetAllGemeentes();
        Werknemers = WerknemerCollection.GetAllWerknemers().Where(werknemer => werknemer.IsActiveInOverview);
    }

    private async void StateChange(object? sender, EventArgs e)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void Show(Client item)
    {
        var parameters = new DialogParameters
        {
            { "Client", item },
            { "ButtonText", "Niks" },
            { "ReadOnly", true }
        };
        DialogService.Show<ClientDialog>("Bestaande Cliënt Inzien", parameters);
    }
}
