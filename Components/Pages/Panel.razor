@page "/panel"
@using OCWebOverview.Data.Collections
@using OCWebOverview.Data.Entities
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using OCWebOverview.Components.Dialogs
@using OCWebOverview.Services
@inject NavigationManager NavigationManager
@inject ClientCollection ClientCollection
@inject GemeenteCollection GemeenteCollection
@inject WerknemerCollection WerknemerCollection
@inject IOptions<AuthOptions> ApplicationSettings
@inject IDialogService DialogService

<style>
    a:hover{
        color: var(--mud-palette-text-primary);
    }
</style>

<div style="flex:auto; flex-direction:column;">
    <header style="background-color:#ffa024; position: fixed; top: 0; height:10px; width: 100%"></header>
    <img src="oclogo.png" style="height:8vh" />
    <MudText Class="d-inline-flex align-items-center px-2" Typo="Typo.body1">Totaal Zorguren: @Clients.SelectMany(c => new[] { c.ZorgUrenHoofd, c.ZorgUrenExtra }).Sum()</MudText>
    <MudText Class="d-inline-flex align-items-center px-2" Typo="Typo.body1">Totaal Werkuren: @Werknemers.Select(c => c.UrenPerWeek).Sum()</MudText>
@if (_id != ApplicationSettings.Value.PanelId)
{
    <MudText Typo="Typo.body1">Geen toegang tot deze content!</MudText>
}
else
{
    <div class="px-2 pb-1" style="height:88vh">
        <div class="d-inline-flex" style="height:100%;">
            @foreach (var werknemer in Werknemers)
            {
                var clientsPerWerknemer = Clients.Where(c => c.HoofdWerknemerId == werknemer.Id).ToList();
                var onderSteuningsClients = Clients.Where(c => c.ExtraWerknemerId == werknemer.Id).ToList();
                <MudPaper Class="ma-1" Width="150px" Style="display: flex; flex-direction: column; ">
                    <div class="px-3 py-1 d-inline-flex align-items-center">
                        <MudText Typo="Typo.h6">@werknemer.Naam</MudText>
                        <MudIcon Size="Size.Small" Icon="@Icons.Material.Rounded.Square" Style="@($"color:{werknemer.ColorHexCode};")" />
                        <MudText Typo="Typo.h6">@werknemer.UrenPerWeek</MudText>
                    </div>
                    <div Class="mud-grid d-inline-flex x-overflow-auto" style="overflow-y:auto;">
                        @foreach (var client in clientsPerWerknemer)
                        {
                            <MudItem Class="pa-1" xs="12">
                                <MudPaper Class="pa-1" Elevation="4" Outlined="true" Style="background-color:#8ffc60">
                                    <MudLink OnClick="() => Show(client)" Color="Color.Default" Underline="Underline.None" Style="">
                                        <MudText Typo="Typo.body2">@client.Voornaam @client.Achternaam</MudText>
                                        <div class="d-inline-flex align-items-center">
                                                    <MudText Typo="Typo.body2">Uren: @client.ZorgUrenHoofd</MudText>
                                            @if (Werknemers.FirstOrDefault(w => w.Id == client.ExtraWerknemerId) != null)
                                            {
                                                <div class="d-inline-flex align-items-center">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Dark" Size="Size.Small"/>
                                                    <MudText Typo="Typo.body2">@(Werknemers.FirstOrDefault(w => w.Id == client.ExtraWerknemerId)?.Naam ?? "0")</MudText>
                                                </div>
                                            }
                                        </div>
                                        <MudText Typo="Typo.body2">Start: @client.StartDatum.Date.ToString("dd-MM-yyyy")</MudText>
                                        <MudText Typo="Typo.body2">Eind: @client.EindDatum.Date.ToString("dd-MM-yyyy")</MudText>
                                        <MudText Typo="Typo.body2">@client.Gemeente.Naam</MudText>
                                    </MudLink>
                                </MudPaper>
                            </MudItem>
                        }
                        @foreach (var client in onderSteuningsClients)
                        {
                            <MudItem Class="pa-1" xs="12">
                                <MudPaper Class="pa-1" Elevation="4" Outlined="true" Style="background-color:#ffa024">
                                    <MudLink OnClick="() => Show(client)" Color="Color.Default" Underline="Underline.None" Style="">
                                        <MudText Typo="Typo.body2">@client.Voornaam @client.Achternaam</MudText>
                                        <MudText Typo="Typo.body2">Uren: @client.ZorgUrenExtra</MudText>
                                        <MudText Typo="Typo.body2">Start: @client.StartDatum.Date.ToString("DD-MM-yyyy")</MudText>
                                        <MudText Typo="Typo.body2">Eind: @client.EindDatum.Date.ToString("DD-MM-yyyy")</MudText>
                                        <MudText Typo="Typo.body2">@client.Gemeente.Naam</MudText>
                                    </MudLink>
                                </MudPaper>
                            </MudItem>
                        }
                    </div>
                    <MudText Class="pa-2" Typo="Typo.body2">Totaal: @(clientsPerWerknemer.Select(c => c.ZorgUrenHoofd).Sum() + onderSteuningsClients.Select(c => c.ZorgUrenExtra).Sum())</MudText>
                </MudPaper>
            }
        </div>
    </div>
        <footer style="height:1vh; background-color:#64b442; position: fixed; bottom: 0; height:10px; width: 100%"></footer>
}
</div>

@code {
    private IEnumerable<Client> Clients;
    private IEnumerable<Gemeente> Gemeentes;
    private IEnumerable<Werknemer> Werknemers;
    private string? _id;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("id", out var idValue))
        {
            _id = idValue;
        }

        ClientCollection.DataChanged += StateChange;
        GemeenteCollection.DataChanged += StateChange;
        WerknemerCollection.DataChanged += StateChange;

        Clients = ClientCollection.GetAllClients();
        Gemeentes = GemeenteCollection.GetAllGemeentes();
        Werknemers = WerknemerCollection.GetAllWerknemers().Where(werknemer => werknemer.IsActiveInOverview);
    }

    private async void StateChange(object? sender, EventArgs e)
    {
        Clients = ClientCollection.GetAllClients();
        Gemeentes = GemeenteCollection.GetAllGemeentes();
        Werknemers = WerknemerCollection.GetAllWerknemers().Where(werknemer => werknemer.IsActiveInOverview);
        await InvokeAsync(StateHasChanged);
    }

    private void Show(Client item)
    {
        var parameters = new DialogParameters
        {
            { "Client", item },
            { "ButtonText", "Niks" },
            { "ReadOnly", true }
        };
        DialogService.Show<ClientDialog>("Bestaande Cliënt Inzien", parameters);
    }
}
