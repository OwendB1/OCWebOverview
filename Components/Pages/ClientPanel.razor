@page "/clienten"
@using Microsoft.IdentityModel.Tokens
@using OCWebOverview.Components.Dialogs
@using OCWebOverview.Data.Collections
@using OCWebOverview.Data.Entities
@attribute [Authorize]
@inject ILocalStorageService Storage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ClientCollection ClientCollection
@inject GemeenteCollection GemeenteCollection
@inject WerknemerCollection WerknemerCollection

<h3>Clienten</h3>

<MudButton Class="mb-2" Variant="Variant.Filled" OnClick="Create">Voeg nieuwe Cliënt toe</MudButton>

<MudTable Items="@Clients" Dense="true" Hover="true" Bordered="false" Striped="false" Filter="new Func<Client,bool>(FilterFunc)" RowsPerPage="_rowsPerPage" RowsPerPageChanged="async (val) => await SetRows(val)">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Cliënten</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.Achternaam)">Naam</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.StartDatum)">Start Datum</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.EindDatum)">Eind Datum</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.ZorgUrenHoofd + x.ZorgUrenExtra)">Zorg Uren Totaal</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.ZorgType)">Zorg Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>Werknemers.First(y => y.Id == x.HoofdWerknemerId).Naam)">Hoofd werknemer</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.Adres.Postcode)">Postcode & Huisnummer</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Client, object>(x=>x.Gemeente.Naam)">Gemeente</MudTableSortLabel></MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Naam">@context.Voornaam @context.Achternaam</MudTd>
        <MudTd DataLabel="Start Datum">@context.StartDatum.Date.ToString("dd-MM-yyyy")</MudTd>
        <MudTd DataLabel="Eind Datum">@context.EindDatum.Date.ToString("dd-MM-yyyy")</MudTd>
        <MudTd DataLabel="Zorg Uren">@(context.ZorgUrenHoofd + context.ZorgUrenExtra)</MudTd>
        <MudTd DataLabel="Zorg Type">@context.ZorgType</MudTd>
        <MudTd DataLabel="Hoofd Werknemer">@Werknemers.First(w => w.Id == context.HoofdWerknemerId).Naam</MudTd>
        <MudTd DataLabel="PC & Hnmr">@(!context.Adres.Postcode.IsNullOrEmpty() ? $"{context.Adres.Postcode}, {context.Adres.HuisNummer}" : "Niet Ingevuld")</MudTd>
        <MudTd DataLabel="Gemeente">@Gemeentes.First(g => g.Id == context.GemeenteId).Naam</MudTd>
        <MudTd DataLabel="Buttons">
            <div class="d-inline-flex">
                <MudButton Variant="Variant.Filled" OnClick="() => Edit(context)" Class="mr-2">Edit</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => Remove(context.Id)">Remove</MudButton>
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100, int.MaxValue }"/>
    </PagerContent>
</MudTable>

    @code {
    private IEnumerable<Client> Clients;
    private IEnumerable<Gemeente> Gemeentes;
    private IEnumerable<Werknemer> Werknemers;

    private string _searchString = "";
    private int _rowsPerPage = 10;

    protected override async Task OnInitializedAsync()
    {
        Clients = ClientCollection.GetAllClients();
        Gemeentes = GemeenteCollection.GetAllGemeentes();
        Werknemers = WerknemerCollection.GetAllWerknemers();
        var duplicates = Clients.GroupBy(c => new { c.Voornaam, c.Achternaam }).Where(c => c.Count() > 1);
        foreach (var duplicate in duplicates)
        {
            Snackbar.Add($"De cliënt {duplicate.Key.Voornaam} {duplicate.Key.Achternaam} bestaat dubbel in het systeem.", Severity.Warning, options => { options.RequireInteraction = true; });
        }
        
        var num = await Storage.GetItemAsync<int>("ClientPanelPagination");
        if (num > 0) _rowsPerPage = num;
    }

    private async Task SetRows(int val)
    {
        _rowsPerPage = val;
        await Storage.SetItemAsync("ClientPanelPagination", val);
    }

    private async Task Create()
    {
        var parameters = new DialogParameters
        {
            { "Client", new Client("", "", DateTime.Today, DateTime.Today, 0, 0, Guid.Empty, null, ZorgType.Jeugd, Guid.Empty, new Adres("", "", "", "")) },
            { "ButtonText", "Toevoegen" },
            { "ReadOnly", false }
        };
        var dialog = await DialogService.ShowAsync<ClientDialog>("Nieuwe Cliënt Toevoegen", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        var client = (Client)result.Data;
        ClientCollection.AddClient(client);
        Snackbar.Add("Nieuwe Cliënt toegevoegd", Severity.Success);
        Clients = ClientCollection.GetAllClients();
        StateHasChanged();
    }

    private async Task Edit(Client item)
    {
        var parameters = new DialogParameters
        {
            { "Client", item },
            { "ButtonText", "Aanpassen" },
            { "ReadOnly", false }
        };
        var dialog = await DialogService.ShowAsync<ClientDialog>("Bestaande Cliënt Aanpassen", parameters);
        var result = await dialog.Result;
        if (result.Canceled) return;

        var client = (Client)result.Data;
        ClientCollection.EditClient(client);
        Snackbar.Add("Bestaande Cliënt aangepast", Severity.Success);
        Clients = ClientCollection.GetAllClients();
        StateHasChanged();
    }

    private void Remove(Guid id)
    {
        ClientCollection.RemoveClient(id);
        Snackbar.Add("Cliënt verwijderd", Severity.Success);
        Clients = ClientCollection.GetAllClients();
        StateHasChanged();
    }

    private bool FilterFunc(Client element)
    {
        var lowerSearchString = _searchString.ToLower();
        if (string.IsNullOrWhiteSpace(lowerSearchString)) return true;
        if (element.Voornaam.ToLower().Contains(lowerSearchString)) return true;
        if (element.Achternaam.ToLower().Contains(lowerSearchString)) return true;
        if (element.Adres.Postcode.ToLower().Contains(lowerSearchString)) return true;
        if (element.StartDatum.Date.ToShortDateString().Contains(_searchString)) return true;
        var res = int.TryParse(_searchString, out var number);
        return res && element.ZorgUrenHoofd + element.ZorgUrenExtra == number;
    }
}
